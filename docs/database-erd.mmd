erDiagram
    USERS ||--|| WALLETS : owns
    WALLETS ||--o{ LEDGER_ENTRIES : records
    PAYMENTS }o--o{ LEDGER_ENTRIES : generates
    REFUND_REQUESTS }o--o{ LEDGER_ENTRIES : generates

    USERS ||--o{ PAYMENTS : initiates_as_customer
    USERS |o--o{ PAYMENTS : submits_as_agent
    BILLERS ||--o{ BILLER_SERVICES : offers
    BILLERS ||--o{ FEE_TIERS : defines
    BILLERS ||--o{ PROMOTIONS : runs
    BILLERS ||--o{ PAYMENTS : receives
    BILLER_SERVICES ||--o{ PAYMENTS : paid_for

    PAYMENTS ||--|{ PAYMENT_STATE_HISTORY : tracks
    PAYMENTS ||--o{ BILLER_CALLBACKS : receives
    PAYMENTS |o--o| REFUND_REQUESTS : has
    PAYMENTS ||--o{ NOTIFICATIONS : triggers
    USERS ||--o{ NOTIFICATIONS : receives

    BILLERS ||--o{ SETTLEMENT_FILES : provides
    SETTLEMENT_FILES ||--o{ RECONCILIATION_ITEMS : contains
    PAYMENTS |o--o{ RECONCILIATION_ITEMS : matched_in

    USERS {
        uuid id PK
        varchar full_name
        varchar phone_number UK
        varchar email UK
        varchar role
        varchar verification_level
        varchar status
        timestamp blocked_until
        varchar block_reason
        timestamp created_at
    }

    WALLETS {
        uuid id PK
        uuid user_id FK,UK
        varchar currency
        timestamp created_at
    }

    LEDGER_ENTRIES {
        uuid id PK
        uuid wallet_id FK
        uuid payment_id FK
        uuid refund_request_id FK
        varchar entry_type
        decimal available_delta
        decimal held_delta
        varchar reason
        timestamp created_at
    }

    SYSTEM_CONFIG {
        uuid id PK
        decimal min_single_payment
        decimal max_single_payment
        decimal basic_daily_limit
        decimal verified_daily_limit
        int velocity_max_payments
        int velocity_window_seconds
        int velocity_block_minutes
        int live_biller_timeout_seconds
        int async_callback_timeout_seconds
        int idempotency_retention_hours
        timestamp updated_at
    }

    BILLERS {
        uuid id PK
        varchar code UK
        varchar name
        varchar protocol
        boolean is_active
        varchar fee_type
        decimal fixed_fee
        decimal percentage_rate
        decimal min_fee
        decimal commission_rate
    }

    BILLER_SERVICES {
        uuid id PK
        uuid biller_id FK
        varchar code
        varchar name
        json required_fields_schema
        boolean is_active
    }

    FEE_TIERS {
        uuid id PK
        uuid biller_id FK
        decimal min_amount
        decimal max_amount
        decimal fee_amount
    }

    PROMOTIONS {
        uuid id PK
        uuid biller_id FK
        varchar name
        date start_date
        date end_date
        boolean is_active
    }

    PAYMENTS {
        uuid id PK
        varchar reference UK
        varchar idempotency_key UK
        varchar request_hash
        uuid customer_id FK
        uuid agent_id FK
        uuid biller_id FK
        uuid service_id FK
        json customer_inputs
        decimal bill_amount
        decimal service_fee
        decimal total_amount
        decimal agent_commission
        varchar state
        varchar failure_reason
        int retry_count
        timestamp unknown_since
        timestamp created_at
        timestamp updated_at
    }

    PAYMENT_STATE_HISTORY {
        uuid id PK
        uuid payment_id FK
        varchar from_state
        varchar to_state
        varchar reason
        varchar triggered_by
        timestamp changed_at
    }

    BILLER_CALLBACKS {
        uuid id PK
        uuid payment_id FK
        varchar external_ref
        varchar raw_status
        json payload_json
        boolean is_duplicate
        boolean is_conflicting
        timestamp received_at
    }

    REFUND_REQUESTS {
        uuid id PK
        uuid payment_id FK,UK
        uuid requested_by FK
        uuid reviewed_by FK
        decimal refund_amount
        decimal commission_clawback
        varchar status
        varchar reason
        timestamp created_at
        timestamp reviewed_at
    }

    NOTIFICATIONS {
        uuid id PK
        uuid user_id FK
        uuid payment_id FK
        varchar channel
        text message_body
        varchar status
        int retry_count
        timestamp last_attempt_at
        timestamp created_at
    }

    SETTLEMENT_FILES {
        uuid id PK
        uuid biller_id FK
        date settlement_date
        varchar file_name
        timestamp uploaded_at
    }

    RECONCILIATION_ITEMS {
        uuid id PK
        uuid settlement_file_id FK
        uuid payment_id FK
        varchar payment_reference
        decimal file_amount
        varchar file_status
        varchar paylink_state
        varchar resolution_status
        varchar notes
    }

    AUDIT_LOGS {
        uuid id PK
        varchar actor_id
        varchar actor_role
        varchar action
        varchar entity_type
        uuid entity_id
        varchar reason
        json metadata_json
        timestamp created_at
    }
