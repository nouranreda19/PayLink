classDiagram
    direction TB

    %% =========================
    %% ENUMS
    %% =========================
    class UserRole {
        <<enumeration>>
        CUSTOMER
        AGENT
        ADMIN
        SUPPORT
    }

    class VerificationLevel {
        <<enumeration>>
        BASIC
        VERIFIED
    }

    class AccountStatus {
        <<enumeration>>
        ACTIVE
        BLOCKED
    }

    class PaymentState {
        <<enumeration>>
        INITIATED
        FUNDS_HELD
        SENT_TO_BILLER
        COMPLETED
        FAILED
        UNKNOWN
        REFUNDED
        REJECTED
    }

    class LedgerEntryType {
        <<enumeration>>
        TOP_UP
        HOLD
        CAPTURE
        RELEASE
        REFUND
        FEE_CREDIT
        COMMISSION_CREDIT
        COMMISSION_REVERSAL
    }

    class BillerProtocol {
        <<enumeration>>
        REST_JSON
        SOAP_XML
        ASYNC_CALLBACK
    }

    class FeeType {
        <<enumeration>>
        FIXED
        PERCENTAGE
        TIERED
    }

    class NotificationChannel {
        <<enumeration>>
        SMS
        PUSH
        EMAIL
    }

    class NotificationStatus {
        <<enumeration>>
        PENDING
        DELIVERED
        FAILED
        UNDELIVERED
    }

    class RefundRequestStatus {
        <<enumeration>>
        PENDING
        APPROVED
        REJECTED
    }

    class ReconciliationItemStatus {
        <<enumeration>>
        MATCHED
        RESOLVED_COMPLETED
        RESOLVED_FAILED
        MISMATCH_FLAGGED
    }

    %% =========================
    %% ACCOUNTS & WALLET
    %% =========================
    class User {
        +UUID id
        +str full_name
        +str phone_number
        +str email
        +UserRole role
        +VerificationLevel verification_level
        +AccountStatus status
        +datetime blocked_until
        +str block_reason
        +datetime created_at
        +is_blocked(now: datetime) bool
        +get_daily_limit(config: SystemConfig) Decimal
    }

    class Wallet {
        +UUID id
        +UUID user_id
        +str currency
        +datetime created_at
        +get_available_balance(entries: list~LedgerEntry~) Decimal
        +get_held_balance(entries: list~LedgerEntry~) Decimal
        +has_sufficient_funds(amount: Decimal, entries: list~LedgerEntry~) bool
    }

    class LedgerEntry {
        +UUID id
        +UUID wallet_id
        +UUID payment_id
        +UUID refund_request_id
        +LedgerEntryType entry_type
        +Decimal available_delta
        +Decimal held_delta
        +str reason
        +datetime created_at
    }

    %% =========================
    %% BILLER CATALOG & FEES
    %% =========================
    class Biller {
        +UUID id
        +str code
        +str name
        +BillerProtocol protocol
        +bool is_active
        +FeeType fee_type
        +Decimal fixed_fee
        +Decimal percentage_rate
        +Decimal min_fee
        +Decimal commission_rate
        +list~FeeTier~ fee_tiers
        +list~Promotion~ promotions
        +calculate_fee(bill_amount: Decimal, on_date: date) Decimal
        +calculate_commission(fee_amount: Decimal) Decimal
    }

    class BillerService {
        +UUID id
        +UUID biller_id
        +str code
        +str name
        +dict required_fields_schema
        +bool is_active
        +validate_inputs(inputs: dict) bool
    }

    class FeeTier {
        +UUID id
        +UUID biller_id
        +Decimal min_amount
        +Decimal max_amount
        +Decimal fee_amount
    }

    class Promotion {
        +UUID id
        +UUID biller_id
        +str name
        +date start_date
        +date end_date
        +bool is_active
        +applies_on(on_date: date) bool
    }

    class SystemConfig {
        +UUID id
        +Decimal min_single_payment
        +Decimal max_single_payment
        +Decimal basic_daily_limit
        +Decimal verified_daily_limit
        +int velocity_max_payments
        +int velocity_window_seconds
        +int velocity_block_minutes
        +int live_biller_timeout_seconds
        +int async_callback_timeout_seconds
        +int idempotency_retention_hours
        +datetime updated_at
    }

    %% =========================
    %% PAYMENT & LIFECYCLE
    %% =========================
    class Payment {
        +UUID id
        +str reference
        +str idempotency_key
        +str request_hash
        +UUID customer_id
        +UUID agent_id
        +UUID biller_id
        +UUID service_id
        +dict customer_inputs
        +Decimal bill_amount
        +Decimal service_fee
        +Decimal total_amount
        +Decimal agent_commission
        +PaymentState state
        +str failure_reason
        +int retry_count
        +datetime unknown_since
        +datetime created_at
        +datetime updated_at
        +transition_to(new_state: PaymentState, reason: str, actor: str) PaymentStateHistory
    }

    class PaymentStateHistory {
        +UUID id
        +UUID payment_id
        +PaymentState from_state
        +PaymentState to_state
        +str reason
        +str triggered_by
        +datetime changed_at
    }

    class BillerCallback {
        +UUID id
        +UUID payment_id
        +str external_ref
        +str raw_status
        +str payload_json
        +bool is_duplicate
        +bool is_conflicting
        +datetime received_at
    }

    class RefundRequest {
        +UUID id
        +UUID payment_id
        +UUID requested_by
        +UUID reviewed_by
        +Decimal refund_amount
        +Decimal commission_clawback
        +RefundRequestStatus status
        +str reason
        +datetime created_at
        +datetime reviewed_at
        +approve(support_user_id: UUID) void
        +reject(support_user_id: UUID, reason: str) void
    }

    %% =========================
    %% BILLER INTEGRATION & FRAUD
    %% =========================
    class BillerAdapter {
        <<interface>>
        +inquire(service: BillerService, inputs: dict) BillInquiryResult
        +pay(payment: Payment) BillerResponse
        +query_status(payment: Payment) BillerResponse
    }

    class ElectroCoAdapter {
        +inquire(service: BillerService, inputs: dict) BillInquiryResult
        +pay(payment: Payment) BillerResponse
        +query_status(payment: Payment) BillerResponse
    }

    class AquaCoAdapter {
        +inquire(service: BillerService, inputs: dict) BillInquiryResult
        +pay(payment: Payment) BillerResponse
        +query_status(payment: Payment) BillerResponse
    }

    class TopUpNetAdapter {
        +inquire(service: BillerService, inputs: dict) BillInquiryResult
        +pay(payment: Payment) BillerResponse
        +query_status(payment: Payment) BillerResponse
    }

    class FraudRule {
        <<abstract>>
        -FraudRule next_rule
        +set_next(rule: FraudRule) FraudRule
        +check(payment: Payment, user: User, config: SystemConfig) FraudCheckResult
    }

    class AccountBlockedRule {
        +check(payment: Payment, user: User, config: SystemConfig) FraudCheckResult
    }

    class SingleLimitRule {
        +check(payment: Payment, user: User, config: SystemConfig) FraudCheckResult
    }

    class DailyLimitRule {
        +check(payment: Payment, user: User, config: SystemConfig) FraudCheckResult
    }

    class VelocityRule {
        +check(payment: Payment, user: User, config: SystemConfig) FraudCheckResult
    }

    %% =========================
    %% NOTIFICATIONS, AUDIT & RECONCILIATION
    %% =========================
    class Notification {
        +UUID id
        +UUID user_id
        +UUID payment_id
        +NotificationChannel channel
        +str message_body
        +NotificationStatus status
        +int retry_count
        +datetime last_attempt_at
        +datetime created_at
        +record_attempt(success: bool) void
    }

    class AuditLog {
        +UUID id
        +str actor_id
        +str actor_role
        +str action
        +str entity_type
        +UUID entity_id
        +str reason
        +str metadata_json
        +datetime created_at
    }

    class SettlementFile {
        +UUID id
        +UUID biller_id
        +date settlement_date
        +str file_name
        +datetime uploaded_at
        +reconcile() list~ReconciliationItem~
    }

    class ReconciliationItem {
        +UUID id
        +UUID settlement_file_id
        +UUID payment_id
        +str payment_reference
        +Decimal file_amount
        +str file_status
        +PaymentState paylink_state
        +ReconciliationItemStatus resolution_status
        +str notes
    }

    %% =========================
    %% RELATIONSHIPS
    %% =========================
    User "1" --> "1" Wallet : owns
    Wallet "1" --> "*" LedgerEntry : records
    Payment "0..1" --> "*" LedgerEntry : generates
    RefundRequest "0..1" --> "*" LedgerEntry : generates

    User "1" --> "*" Payment : initiates as customer
    User "0..1" --> "*" Payment : submits as agent
    Biller "1" --> "*" BillerService : offers
    Biller "1" --> "*" FeeTier : defines
    Biller "1" --> "*" Promotion : runs
    Biller "1" --> "*" Payment : receives
    BillerService "1" --> "*" Payment : paid for

    Payment "1" --> "1..*" PaymentStateHistory : tracks transitions
    Payment "1" --> "*" BillerCallback : receives callbacks
    Payment "1" --> "0..1" RefundRequest : requested for
    Payment "1" --> "*" Notification : triggers
    User "1" --> "*" Notification : receives

    BillerAdapter <|.. ElectroCoAdapter
    BillerAdapter <|.. AquaCoAdapter
    BillerAdapter <|.. TopUpNetAdapter
    Biller ..> BillerAdapter : uses

    FraudRule <|-- AccountBlockedRule
    FraudRule <|-- SingleLimitRule
    FraudRule <|-- DailyLimitRule
    FraudRule <|-- VelocityRule
    FraudRule o--> "0..1" FraudRule : next
    Payment ..> FraudRule : validated by

    Biller "1" --> "*" SettlementFile : provides
    SettlementFile "1" --> "*" ReconciliationItem : contains
    Payment "0..1" --> "*" ReconciliationItem : matched in

    User ..> AuditLog : audited in
    Payment ..> AuditLog : audited in
    SystemConfig ..> AuditLog : audited in
